ENVIRONMENT=development
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=hear_the_unheard
# docker-compose overrides MONGODB_URL to point at the `mongo` service —
# see docker-compose.yml.

SECRET_KEY=change-me-to-a-long-random-value-before-any-real-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=["http://localhost:3000"]
